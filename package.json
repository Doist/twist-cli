{
    "name": "@doist/twist-cli",
    "version": "2.21.2",
    "description": "TypeScript CLI for Twist",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "tw": "dist/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
        "dev": "tsc -p tsconfig.build.json --watch",
        "start": "node dist/index.js",
        "type-check": "tsc --noEmit",
        "lint": "biome check --write .",
        "lint:check": "biome check .",
        "format": "biome format --write . && prettier --write '**/*.{md,yml,yaml,css}'",
        "format:check": "biome check --formatter-enabled=true . && prettier --check '**/*.{md,yml,yaml,css}'",
        "postinstall": "node scripts/postinstall.js",
        "check:skill-sync": "node scripts/check-skill-sync.js",
        "sync:skill": "npm run build && node scripts/sync-skill.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build && npm test"
    },
    "keywords": [
        "twist",
        "cli",
        "messaging",
        "doist"
    ],
    "author": "Ernesto García <ernesto@ernesto.dev>",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Doist/twist-cli.git"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "homepage": "https://github.com/Doist/twist-cli#readme",
    "bugs": {
        "url": "https://github.com/Doist/twist-cli/issues"
    },
    "files": [
        "dist",
        "scripts",
        "CHANGELOG.md"
    ],
    "dependencies": {
        "@doist/twist-sdk": "2.2.0",
        "@pnpm/tabtab": "0.5.4",
        "chalk": "5.6.2",
        "commander": "14.0.3",
        "marked": "15.0.12",
        "marked-terminal": "7.3.0",
        "open": "11.0.0",
        "yocto-spinner": "1.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.8",
        "@semantic-release/changelog": "6.0.3",
        "@semantic-release/exec": "7.1.0",
        "@semantic-release/git": "10.0.1",
        "@types/node": "25.5.0",
        "conventional-changelog-conventionalcommits": "9.3.0",
        "lefthook": "2.1.4",
        "prettier": "3.8.1",
        "semantic-release": "25.0.3",
        "typescript": "6.0.2",
        "vitest": "4.1.1"
    },
    "optionalDependencies": {
        "@napi-rs/keyring": "1.2.0"
    }
}
